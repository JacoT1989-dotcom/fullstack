generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                   @id @default(uuid())
  username               String                   @unique
  firstName              String
  lastName               String
  displayName            String
  email                  String                   @unique
  passwordHash           String
  phoneNumber            String                   @default("")
  streetAddress          String
  suburb                 String?
  townCity               String
  postcode               String
  country                String
  avatarUrl              String?
  backgroundUrl          String?
  agreeTerms             Boolean                  @default(false)
  role                   UserRole                 @default(USER)
  Session                Session[]
  Product                Product[]
  Slide                  Slide[]
  NewArrival             NewArrival[]
  BestSeller             BestSeller[]
  OnSale                 OnSale[]
  NewsletterSubscription NewsletterSubscription[]
  Audio                  Audio[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum UserRole {
  USER
  CUSTOMER
  PROCUSTOMER
  EDITOR
  ADMIN
  SUPERADMIN
}

// ADMIN
model Product {
  id String @id @default(uuid())

  productName   String   @map("product_name")
  category      String[]
  productImgUrl String
  description   String
  sellingPrice  Float    @map("selling_price")
  isPublished   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Variation Variation[]

  @@map("products")
}

model Variation {
  id String @id @default(uuid())

  name     String // Name of the variation
  color    String // Color of the variation
  size     String // Size of the variation
  sku      String // Stock Keeping Unit
  quantity Int // Available quantity
  price    Float // Price specific to this variation
  imageUrl String // Image URL for this variation

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("variations")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

// EDITOR
model Slide {
  id             String @id @default(uuid())
  sliderImageurl String
  title          String
  description    String
  bgColor        String
  order          Int // Added to maintain slide order
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("slides")
}

model NewArrival {
  id        String   @id @default(uuid())
  name      String
  price     Float
  rating    Int
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("new_arrivals")
}

model BestSeller {
  id        String   @id @default(uuid())
  name      String
  price     Float
  rating    Int
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("best_sellers")
}

model OnSale {
  id            String   @id @default(uuid())
  name          String
  originalPrice Float
  salePrice     Float
  rating        Int
  imageUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("on_sale")
}

model NewsletterSubscription {
  id                  String             @id @default(uuid())
  email               String             @unique
  status              SubscriptionStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  wantsProductUpdates Boolean            @default(true)
  wantsPromotions     Boolean            @default(true)
  wantsNewsletter     Boolean            @default(true)

  @@map("newsletter_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

model Audio {
  id        String   @id @default(uuid())
  audioUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? // Optional user ID to allow anonymous uploads
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audios")
}
